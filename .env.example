# Which data source the app talks to: "mock" (bundled JSON) or "api" (real backend).
# Unknown values safely fall back to "mock".
VITE_DASHBOARD_DATA_SOURCE=mock

# Toggle simulated network latency on the mock source.
VITE_ENABLE_MOCKS=true

# Mock latency profile: off | fast | normal | slow
VITE_MOCK_LATENCY=normal

# Base URL of the real API (only used when VITE_DASHBOARD_DATA_SOURCE=api)
VITE_API_BASE_URL=
